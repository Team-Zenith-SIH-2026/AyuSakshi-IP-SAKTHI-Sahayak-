# ==============================================================================
# AyuSakshi (IP-SAKTI Sahayak) - Environment Configuration
# SIH26045 - Multilingual RAG-Based AI Assistant for Ayurveda IP & Regulations
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL + pgvector)
POSTGRES_USER=ayusakshi_user
POSTGRES_PASSWORD=ayusakshi_secure_pass_2026
POSTGRES_DB=ayusakshi_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ayusakshi_user:ayusakshi_secure_pass_2026@localhost:5432/ayusakshi_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT Security
JWT_SECRET=ayusakshi_jwt_super_secret_key_sih26045_prod_ready
JWT_EXPIRES_IN=7d

# OAuth Providers (Google & Facebook)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# Python AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=ayusakshi_internal_ai_token_2026

# LLM Providers. Preference order is groq -> openai -> ollama.
# Groq is the working default: fast and free-tier, so the demo does not depend
# on a paid key. Ollama is the offline / on-premise path.
LLM_PROVIDER=groq

GROQ_API_KEY=your_groq_api_key
# Leave this set explicitly. Unset, the code falls back to openai/gpt-oss-120b,
# which burns the free-tier per-minute token budget far faster.
GROQ_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=your_openai_api_key_or_mock
OPENAI_MODEL=gpt-4o-mini

# On-premise / air-gapped fallback. From inside Docker the host is
# host.docker.internal, not localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Must be identical at seed time and query time. Changing it after seeding
# compares stored vectors against a different embedding space.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval and abstention tuning. Raise CONFIDENCE_ABSTAIN_THRESHOLD to refuse
# more often, lower it to answer more often.
SIMILARITY_THRESHOLD=0.30
CONFIDENCE_ABSTAIN_THRESHOLD=0.50
CITATION_RELEVANCE_FLOOR=0.10

# Bhashini Multilingual API
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id
BHASHINI_ENABLED=false

# Ingestion & Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Email Delivery & SMTP Configuration (Password Reset & Notifications)
EMAIL_PROVIDER=console # 'smtp' or 'console' (defaults to 'console' if SMTP_HOST is unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM="AyuSakshi Security <no-reply@ayusakshi.gov.in>"

